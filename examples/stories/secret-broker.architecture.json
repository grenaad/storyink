{
  "$schema": "../../schema/storyink.schema.json",
  "type": "architecture",
  "title": "Who sees the secret?",
  "subtitle": "A coding agent asks for an API key: raw CLI, then through a secret broker",
  "direction": "LR",
  "nodes": [
    { "id": "agent", "kind": "client", "label": "coding agent", "detail": "chat session" },
    { "id": "broker", "kind": "service", "label": "secret broker", "detail": "hands out references", "in": ["after"] },
    { "id": "cli", "kind": "function", "label": "vault CLI", "detail": "signed in" },
    { "id": "vault", "kind": "database", "label": "Vault service", "detail": "API keys" },
    { "id": "devserver", "kind": "service", "label": "dev server", "detail": "needs API_KEY", "in": ["after"] },
    { "id": "keychain", "kind": "store", "label": "OS keychain", "detail": "session token", "in": ["after"] }
  ],
  "edges": [
    { "id": "ask", "from": "agent", "to": "cli", "in": ["before"] },
    { "id": "ref", "from": "agent", "to": "broker" },
    { "id": "approve", "from": "broker", "to": "cli" },
    { "id": "fetch", "from": "cli", "to": "vault" },
    { "id": "inject", "from": "cli", "to": "devserver" },
    { "id": "unlock", "from": "keychain", "to": "devserver" }
  ],
  "annotations": [
    { "id": "chat", "on": "agent", "text": "chat ▸ sk-live-7Hq2Zx9mK4pL…", "tone": "risk" }
  ],
  "story": {
    "acts": [
      { "id": "before", "label": "raw CLI", "tone": "risk" },
      { "id": "after", "label": "with broker", "tone": "good" }
    ],
    "hud": [{ "id": "prompts", "label": "prompts", "value": 0 }],
    "steps": [
      {
        "caption": "The agent asks the vault CLI for an API key",
        "pulse": { "edge": "ask", "tone": "note", "label": "vault get \"OpenAI API Key\"", "tint": true }
      },
      {
        "id": "prompt",
        "caption": "The CLI wants a human to approve",
        "set": [
          { "id": "cli", "detail": "approval required", "tone": "warn" },
          { "id": "agent", "detail": "waiting for approval…", "tone": "warn" }
        ],
        "status": { "id": "agent", "to": "running" },
        "tone": { "ids": "cli", "to": "warn" },
        "toast": { "id": "p1", "near": "cli", "title": "Allow access?", "text": "vault CLI wants 1 secret", "tone": "warn" },
        "counter": { "id": "prompts", "to": 1 }
      },
      {
        "caption": "…and again: the prompts pile up",
        "toast": { "id": "p2", "near": "cli", "title": "Approve this request?", "text": "OpenAI API Key · read", "tone": "warn" },
        "counter": { "id": "prompts", "to": 2 },
        "hold": 0.4
      },
      {
        "toast": { "id": "p3", "near": "cli", "title": "Sign in to continue", "text": "session expired", "tone": "warn" },
        "counter": { "id": "prompts", "to": 3 },
        "set": { "id": "agent", "detail": "stuck", "tone": "warn" },
        "hold": 0.4
      },
      {
        "caption": "Nobody reads prompt number four",
        "toast": { "id": "p4", "near": "cli", "title": "AUTHORIZE?!", "text": "click yes to make this stop", "tone": "risk" },
        "counter": { "id": "prompts", "to": 4 }
      },
      {
        "caption": "Someone clicks yes and the risk spreads",
        "pulse": { "edge": "fetch", "tone": "warn", "label": "read API key" },
        "tone": [
          { "ids": ["p1", "p2", "p3", "cli", "ask", "agent"], "to": "risk", "stagger": 0.15 },
          { "ids": "prompts", "to": "risk" }
        ]
      },
      {
        "caption": "The *raw key* lands in the agent's chat",
        "dismiss": "all",
        "pulse": { "edge": "ask", "reverse": true, "tone": "risk", "label": "sk-live-7Hq2Zx9mK4pL…", "tint": true }
      },
      {
        "status": { "id": "agent", "to": "error" },
        "set": { "id": "agent", "detail": "secret in the chat!", "tone": "risk" },
        "type": { "id": "chat", "cps": 24 }
      },
      {
        "act": "after",
        "caption": "Same request, with a secret broker in between"
      },
      {
        "caption": "The agent asks the broker for a reference",
        "pulse": { "edge": "ref", "tone": "note", "label": "get ref://API Key", "tint": true }
      },
      {
        "caption": "The broker asks once; the human approves once",
        "pulse": { "edge": "approve", "tone": "warn", "label": "approve once", "tint": true }
      },
      {
        "set": { "id": "cli", "detail": "approved once", "tone": "good" },
        "status": { "id": "cli", "to": "done" },
        "toast": { "id": "once", "near": "cli", "title": "approved once ✓", "text": "no more prompts this session", "tone": "good", "for": 2.8 }
      },
      {
        "caption": "Only a reference goes back to the agent",
        "pulse": [
          { "edge": "fetch", "tone": "good", "label": "read API key", "tint": true, "stain": true },
          { "route": ["ref", "approve"], "reverse": true, "tone": "good", "label": "ref://Personal/API Key", "stain": true, "tint": true, "delay": 0.4 }
        ],
        "set": [
          { "id": "broker", "detail": "references only", "tone": "good" },
          { "id": "agent", "detail": "holds a reference", "tone": "good" },
          { "id": "chat", "text": "chat ▸ ref://Personal/API Key/credential", "tone": "good" }
        ],
        "status": { "id": "agent", "to": "done" },
        "tone": { "ids": ["broker", "cli"], "to": "good", "stagger": 0.2 }
      },
      {
        "caption": "Secrets go to processes, *never to the agent*",
        "reveal": ["keychain", "devserver"],
        "pulse": [
          { "edge": "unlock", "tone": "note", "label": "token" },
          { "edge": "inject", "tone": "good", "label": "API_KEY", "tint": true, "stain": true, "delay": 0.5 }
        ],
        "tone": { "ids": "prompts", "to": "good" }
      }
    ]
  }
}
