  "story": {
    "steps": [
      {
        "at": 0.3,
        "reveal": [
          "dom"
        ],
        "stop": "Core",
        "caption": "ow-domain defines the ports the outer layers code against"
      },
      {
        "at": "+0.4",
        "reveal": [
          "xc"
        ],
        "caption": "ow-crosscutting adds the shared kernel and the MessageBus"
      },
      {
        "at": "+0.6",
        "reveal": [
          "gw"
        ],
        "stop": "Gateway",
        "caption": "LiveGateway implements the Gateway port in front of all sources"
      },
      {
        "at": "+0.4",
        "reveal": [
          "db"
        ],
        "caption": "It keeps a hot bar window and persists closed bars to LibSQL"
      },
      {
        "at": "+0.4",
        "reveal": [
          "srcs"
        ],
        "caption": "The SourceRegistry runs one actor task per source"
      },
      {
        "at": "+0.4",
        "reveal": [
          "conn"
        ],
        "caption": "Connector crates adapt MT5, Binance, OANDA, IBKR and more"
      },
      {
        "at": "+0.4",
        "pulse": "e_src_gw",
        "caption": "Adapter events enter the gateway only through ingest()"
      },
      {
        "at": "+0.6",
        "pulse": "e_conn_dll",
        "stop": "Venues",
        "caption": "ow-mt5 talks HTTP and WebSocket to a bridge inside MT5"
      },
      {
        "at": "+0",
        "reveal": [
          "dll"
        ]
      },
      {
        "at": "+0.4",
        "pulse": "e_dll_ea",
        "caption": "The EA loads the bridge DLL over FFI and trades via CTrade"
      },
      {
        "at": "+0",
        "reveal": [
          "ea"
        ]
      },
      {
        "at": "+0.4",
        "pulse": "e_conn_ven",
        "caption": "Other venues are reached with HTTPS and WebSocket clients"
      },
      {
        "at": "+0",
        "reveal": [
          "venues"
        ]
      },
      {
        "at": "+0.4",
        "pulse": "e_src_feeds",
        "caption": "News and economic-calendar feeds are polled over HTTP"
      },
      {
        "at": "+0",
        "reveal": [
          "feeds"
        ]
      },
      {
        "at": "+0.6",
        "pulse": "e_gw_rt",
        "stop": "Plugins",
        "caption": "ingest() fans each event out to indicators and bots"
      },
      {
        "at": "+0",
        "reveal": [
          "rt"
        ]
      },
      {
        "at": "+0.4",
        "reveal": [
          "cabi"
        ],
        "caption": "Rust plugins are cdylibs loaded in-process over the C ABI"
      },
      {
        "at": "+0",
        "pulse": "e_cabi_rt"
      },
      {
        "at": "+0.6",
        "reveal": [
          "appc"
        ],
        "stop": "API",
        "caption": "ow-application builds the container and reaches the Gateway port"
      },
      {
        "at": "+0.4",
        "reveal": [
          "api"
        ],
        "caption": "ow-api serves REST, SSE and plugin WebSockets with Axum"
      },
