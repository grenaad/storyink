        "at": "+0.4",
        "pulse": {
          "route": [
            "e_gw_bus",
            "e_bus_api"
          ]
        },
        "caption": "Events leave through the MessageBus as one SSE broadcast"
      },
      {
        "at": "+0.4",
        "pulse": "e_bus_redis",
        "caption": "The same bytes can also be recorded to Redis Streams"
      },
      {
        "at": "+0",
        "reveal": [
          "redis"
        ]
      },
      {
        "at": "+0.4",
        "reveal": [
          "cli"
        ],
        "caption": "The openwick binary (ow-cli) starts the server via start()"
      },
      {
        "at": "+0",
        "pulse": "e_cli_boot"
      },
      {
        "at": "+0",
        "reveal": [
          "boot"
        ]
      },
