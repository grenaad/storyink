        "at": "+0.1",
        "highlight": [
          "boot"
        ],
        "caption": "ow-bootstrap wires the bus, sinks, sources and the router"
      },
      {
        "at": "+0.6",
        "reveal": [
          "bunc"
        ],
        "stop": "Clients",
        "caption": "The Bun app (cli.ts) is the entry for TUI, serve and web modes"
