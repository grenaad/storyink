{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/storyink/schema/storyink.schema.json",
  "title": "storyink diagram spec",
  "description": "One spec shape for architecture, workflow, sequence, dataflow and lifecycle diagrams. See docs/spec.md.",
  "type": "object",
  "required": [
    "type",
    "title"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "enum": [
        "architecture",
        "workflow",
        "sequence",
        "dataflow",
        "lifecycle"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "TB",
        "TD",
        "BT",
        "LR",
        "RL"
      ],
      "description": "Graph types only. Omit to auto-pick TB or LR by aspect ratio (closest to 16:10)."
    },
    "story": {
      "description": "Storyboard (opt-in). \"auto\" derives steps from graph / message order.",
      "oneOf": [
        {
          "const": "auto"
        },
        {
          "type": "object",
          "required": [
            "steps"
          ],
          "additionalProperties": false,
          "properties": {
            "autoplay": {
              "type": "boolean"
            },
            "motion": {
              "enum": [
                "full",
                "reduced",
                "system"
              ],
              "description": "Playback motion (default full). full: always animate; reduced: always step through settled steps; system: follow prefers-reduced-motion. The reader's toolbar choice and #motion= win."
            },
            "camera": {
              "enum": [
                "follow",
                "fit"
              ],
              "description": "Viewer camera while playing (default follow). follow: zoom to a readable scale when fit is too small and pan to each step; fit: keep the whole diagram in view. The reader's Follow toggle and #camera= win."
            },
            "end": {
              "enum": [
                "hold",
                "loop"
              ]
            },
            "steps": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "at": {
                        "oneOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "string",
                            "pattern": "^\\+\\s*\\d+(\\.\\d+)?$"
                          }
                        ]
                      },
                      "reveal": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "pulse": {
                        "oneOf": [
                          {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "edge": {
                                    "type": "string"
                                  },
                                  "route": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    },
                                    "minItems": 1
                                  },
                                  "duration": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  }
                                }
                              }
                            ]
                          },
                          {
                            "type": "array",
                            "items": {
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "edge": {
                                      "type": "string"
                                    },
                                    "route": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      },
                                      "minItems": 1
                                    },
                                    "duration": {
                                      "type": "number",
                                      "exclusiveMinimum": 0
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      },
                      "highlight": {
                        "oneOf": [
                          {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            ]
                          },
                          {
                            "type": "object",
                            "required": [
                              "ids"
                            ],
                            "properties": {
                              "ids": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "for": {
                                "type": "number"
                              }
                            }
                          }
                        ]
                      },
                      "caption": {
                        "type": "string"
                      },
                      "counter": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "id",
                              "to"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "to": {
                                "type": "number"
                              }
                            }
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "to"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "to": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        ]
                      },
                      "stop": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "const": "auto",
                  "description": "Derive the steps (like \"story\": \"auto\")"
                }
              ]
            }
          }
        }
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arrowheads": {
          "type": "boolean",
          "description": "Draw arrowheads on graph edges (default false; sequences always have heads)."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "sequence"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/sequence"
      },
      "else": {
        "$ref": "#/$defs/graph"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "architecture",
              "dataflow"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "kind": {
                  "$ref": "#/$defs/architectureKind"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workflow"
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "kind": {
                  "$ref": "#/$defs/workflowKind"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "lifecycle"
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "kind": {
                  "$ref": "#/$defs/lifecycleKind"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:\\-]*$"
    },
    "architectureKind": {
      "enum": [
        "service",
        "database",
        "store",
        "queue",
        "client",
        "user",
        "external",
        "cache",
        "function",
        "note"
      ]
    },
    "workflowKind": {
      "enum": [
        "start",
        "end",
        "step",
        "decision",
        "io",
        "note"
      ]
    },
    "lifecycleKind": {
      "enum": [
        "initial",
        "final",
        "state",
        "composite",
        "choice",
        "fork",
        "join",
        "note"
      ]
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "description": "Shape and accent. Default: service / step / state."
              },
              "detail": {
                "type": "string",
                "description": "Muted second line (technology, responsibility)."
              },
              "tag": {
                "type": "string",
                "description": "Small uppercase tag above the label. Architecture/dataflow default to the kind; \"\" hides it."
              },
              "parent": {
                "type": "string",
                "description": "Containing group id, or a composite state id (lifecycle)."
              },
              "group": {
                "type": "string",
                "description": "Alias of parent."
              },
              "direction": {
                "enum": [
                  "TB",
                  "TD",
                  "BT",
                  "LR",
                  "RL"
                ],
                "description": "Composite states: inner layout direction (best-effort)."
              },
              "counter": {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  },
                  "prefix": {
                    "type": "string"
                  },
                  "suffix": {
                    "type": "string"
                  }
                },
                "description": "Rolling counter driven by story counter steps."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable id. Default \"from->to\" (with #n for duplicates)."
              },
              "from": {
                "type": "string",
                "description": "Node or group id."
              },
              "to": {
                "type": "string",
                "description": "Node or group id."
              },
              "label": {
                "type": "string"
              },
              "style": {
                "enum": [
                  "solid",
                  "dashed",
                  "thick"
                ]
              },
              "arrow": {
                "enum": [
                  "end",
                  "none",
                  "both"
                ]
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "description": "Free-form flavour shown next to the label: vpc, cluster, tier, region..."
              },
              "parent": {
                "type": "string",
                "description": "Parent group id (nesting)."
              },
              "direction": {
                "enum": [
                  "TB",
                  "TD",
                  "BT",
                  "LR",
                  "RL"
                ],
                "description": "Inner layout direction for this group's members (best-effort)."
              }
            }
          }
        }
      }
    },
    "messageRef": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ],
      "description": "0-based index into messages, or a message id."
    },
    "sequence": {
      "type": "object",
      "required": [
        "participants",
        "messages"
      ],
      "properties": {
        "autonumber": {
          "type": "boolean"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "participant",
                  "actor",
                  "service",
                  "database",
                  "queue",
                  "external"
                ]
              }
            }
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "sync",
                  "async",
                  "return",
                  "self"
                ]
              }
            }
          }
        },
        "activations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "participant",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "participant": {
                "type": "string"
              },
              "start": {
                "$ref": "#/$defs/messageRef"
              },
              "end": {
                "$ref": "#/$defs/messageRef"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "over": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 2
              },
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "after": {
                "$ref": "#/$defs/messageRef"
              },
              "outside": {
                "type": "boolean",
                "description": "Draw after every frame that closes at the anchor message (default: inside the innermost frame)."
              }
            }
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "alt",
                  "opt",
                  "loop",
                  "par",
                  "critical",
                  "break"
                ]
              },
              "label": {
                "type": "string"
              },
              "start": {
                "$ref": "#/$defs/messageRef"
              },
              "end": {
                "$ref": "#/$defs/messageRef"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "start"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "start": {
                      "$ref": "#/$defs/messageRef"
                    }
                  }
                }
              }
            }
          }
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "$ref": "#/$defs/messageRef"
              },
              "end": {
                "$ref": "#/$defs/messageRef"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "description": "Background bands behind message ranges (Mermaid rect)."
        },
        "boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "participants"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "description": "Groups of adjacent participants (Mermaid box)."
        }
      }
    }
  }
}
